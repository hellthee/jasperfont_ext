    <property name="net.sf.jasperreports.default.font.name" value="Chinese"/>

    <parameter name="reportTitle" class="java.lang.String">
        <defaultValueExpression><![CDATA["中文报告示例 / Chinese Report Demo"]]></defaultValueExpression>
    </parameter>
    <parameter name="companyName" class="java.lang.String">
        <defaultValueExpression><![CDATA["示例公司 Example Corp"]]></defaultValueExpression>
    </parameter>

    <field name="productName" class="java.lang.String"/>
    <field name="productNameCN" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="total" class="java.math.BigDecimal"/>

    <variable name="grandTotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total}]]></variableExpression>
    </variable>

    <title>
        <band height="80" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="535" height="40" uuid="fdbe6d5a-8541-4036-8cbc-9cfa15fc5be9"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Chinese" size="20" isBold="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
