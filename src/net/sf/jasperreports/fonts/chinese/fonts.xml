<?xml version="1.0" encoding="UTF-8"?>
<!--
  JasperReports font extension — Simplified Chinese.

  Built by build.py from Noto Sans CJK SC. The font is modified (CFF
  outlines converted to TrueType, OS/2 metrics realigned) but keeps its
  upstream name: Noto carries no Reserved Font Name, so OFL 1.1 permits
  this. The notice and license ship in OFL.txt per OFL section 2.

  pdfEncoding Identity-H is mandatory: a single-byte encoding cannot
  address CJK code points and characters outside it render blank.
-->
<fontFamilies>

  <fontFamily name="Noto Sans SC">
    <normal>net/sf/jasperreports/fonts/chinese/NotoSansSC-Regular.ttf</normal>
    <bold>net/sf/jasperreports/fonts/chinese/NotoSansSC-Bold.ttf</bold>
    <italic>net/sf/jasperreports/fonts/chinese/NotoSansSC-Regular.ttf</italic>
    <boldItalic>net/sf/jasperreports/fonts/chinese/NotoSansSC-Bold.ttf</boldItalic>
    <pdfEncoding>Identity-H</pdfEncoding>
    <pdfEmbedded>true</pdfEmbedded>
    <exportFonts>
      <export key="net.sf.jasperreports.html">"Noto Sans SC", "PingFang SC", "Microsoft YaHei", SimSun, sans-serif</export>
      <export key="net.sf.jasperreports.xhtml">"Noto Sans SC", "PingFang SC", "Microsoft YaHei", SimSun, sans-serif</export>
    </exportFonts>
  </fontFamily>

  <!-- Short alias used by the JRXMLs in examples/. Same font files. -->
  <fontFamily name="Chinese">
    <normal>net/sf/jasperreports/fonts/chinese/NotoSansSC-Regular.ttf</normal>
    <bold>net/sf/jasperreports/fonts/chinese/NotoSansSC-Bold.ttf</bold>
    <italic>net/sf/jasperreports/fonts/chinese/NotoSansSC-Regular.ttf</italic>
    <boldItalic>net/sf/jasperreports/fonts/chinese/NotoSansSC-Bold.ttf</boldItalic>
    <pdfEncoding>Identity-H</pdfEncoding>
    <pdfEmbedded>true</pdfEmbedded>
    <exportFonts>
      <export key="net.sf.jasperreports.html">"Noto Sans SC", "PingFang SC", "Microsoft YaHei", SimSun, sans-serif</export>
      <export key="net.sf.jasperreports.xhtml">"Noto Sans SC", "PingFang SC", "Microsoft YaHei", SimSun, sans-serif</export>
    </exportFonts>
  </fontFamily>

</fontFamilies>
