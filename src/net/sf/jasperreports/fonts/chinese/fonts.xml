<?xml version="1.0" encoding="UTF-8"?>
<!--
  JasperReports font extension — Simplified Chinese.

  Built by build.py from Noto Sans CJK SC. The font is modified (CFF
  outlines converted to TrueType, OS/2 metrics realigned) but keeps its
  upstream name: Noto carries no Reserved Font Name, so OFL 1.1 permits
  this. The notice and license ship in OFL.txt per OFL section 2.

  pdfEncoding Identity-H is mandatory: a single-byte encoding cannot
  address CJK code points and characters outside it render blank.

  Office exports name "Noto Sans CJK SC": the font's internal family
  name, and therefore the name Word/PowerPoint find when the TTF from
  this build is installed. "Noto Sans SC" (the JasperReports family
  name) would not match it. For recipients without the font, run
  java/OoxmlFontSubstituter on docx/pptx output. Excel has no
  per-script font on a cell, so xlsx/xls use Arial and Excel's own
  fallback renders the Chinese.
-->
<fontFamilies>

  <fontFamily name="Noto Sans SC">
    <normal>net/sf/jasperreports/fonts/chinese/NotoSansSC-Regular.ttf</normal>
    <bold>net/sf/jasperreports/fonts/chinese/NotoSansSC-Bold.ttf</bold>
    <italic>net/sf/jasperreports/fonts/chinese/NotoSansSC-Regular.ttf</italic>
    <boldItalic>net/sf/jasperreports/fonts/chinese/NotoSansSC-Bold.ttf</boldItalic>
    <pdfEncoding>Identity-H</pdfEncoding>
    <pdfEmbedded>true</pdfEmbedded>
    <exportFonts>
      <export key="net.sf.jasperreports.html">"Noto Sans CJK SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", SimSun, sans-serif</export>
      <export key="net.sf.jasperreports.xhtml">"Noto Sans CJK SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", SimSun, sans-serif</export>
      <export key="net.sf.jasperreports.docx">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.pptx">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.rtf">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.odt">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.ods">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.xlsx">Arial</export>
      <export key="net.sf.jasperreports.xls">Arial</export>
    </exportFonts>
  </fontFamily>

  <!-- Short alias used by the JRXMLs in examples/. Same font files. -->
  <fontFamily name="Chinese">
    <normal>net/sf/jasperreports/fonts/chinese/NotoSansSC-Regular.ttf</normal>
    <bold>net/sf/jasperreports/fonts/chinese/NotoSansSC-Bold.ttf</bold>
    <italic>net/sf/jasperreports/fonts/chinese/NotoSansSC-Regular.ttf</italic>
    <boldItalic>net/sf/jasperreports/fonts/chinese/NotoSansSC-Bold.ttf</boldItalic>
    <pdfEncoding>Identity-H</pdfEncoding>
    <pdfEmbedded>true</pdfEmbedded>
    <exportFonts>
      <export key="net.sf.jasperreports.html">"Noto Sans CJK SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", SimSun, sans-serif</export>
      <export key="net.sf.jasperreports.xhtml">"Noto Sans CJK SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", SimSun, sans-serif</export>
      <export key="net.sf.jasperreports.docx">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.pptx">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.rtf">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.odt">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.ods">Noto Sans CJK SC</export>
      <export key="net.sf.jasperreports.xlsx">Arial</export>
      <export key="net.sf.jasperreports.xls">Arial</export>
    </exportFonts>
  </fontFamily>

</fontFamilies>
